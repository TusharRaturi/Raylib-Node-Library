<Project>
  <PropertyGroup>
    <!-- Target Frameworks -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Shared Package Metadata -->
    <Authors>Tushar Raturi</Authors>
    <Company>Binary Tantra</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Binary-Tantra/PratyakshLib</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Binary-Tantra/PratyakshLib</PackageProjectUrl>

    <!-- Unified Package Versioning -->
    <VersionPrefix>0.1.12</VersionPrefix>
    
    <!-- Embed PDBs for debugging -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Package README configuration -->
    <PackageReadmeFile Condition="Exists('README.md')">README.md</PackageReadmeFile>
    <PackageReadmeFile Condition="!Exists('README.md') and Exists('$(MSBuildThisFileDirectory)README.md')">README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Include README in all packages if available -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Condition="Exists('README.md')" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Condition="!Exists('README.md') and Exists('$(MSBuildThisFileDirectory)README.md')" />
  </ItemGroup>
</Project>